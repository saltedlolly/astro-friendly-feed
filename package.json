{
  "name": "astro-friendly-feed",
  "version": "0.3.0",
  "description": "Friendly Feed for Astro: people who open your RSS or Atom feed in a browser see a friendly page explaining how to subscribe, at the same address, while feed readers still get the feed. No XSLT.",
  "type": "module",
  "license": "MIT",
  "author": "Olly Stedall (https://saltedlolly.com)",
  "homepage": "https://github.com/saltedlolly/astro-friendly-feed#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saltedlolly/astro-friendly-feed.git"
  },
  "bugs": "https://github.com/saltedlolly/astro-friendly-feed/issues",
  "keywords": [
    "astro-integration",
    "astro-component",
    "withastro",
    "rss",
    "atom",
    "feed",
    "json-feed",
    "subscribe",
    "xslt",
    "pretty-feed",
    "ui",
    "i18n"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./FeedPage.astro": "./components/FeedPage.astro",
    "./middleware": "./middleware.mjs"
  },
  "types": "./index.d.ts",
  "files": [
    "index.mjs",
    "index.d.ts",
    "middleware.mjs",
    "virtual.d.ts",
    "components",
    "lib",
    "locales",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  }
}
