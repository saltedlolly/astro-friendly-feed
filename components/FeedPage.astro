---
// The friendly feed page: put it inside your own layout, on the page the
// integration's `page` option names (default /subscribe/). The middleware
// shows that page at your feeds' addresses when someone opens one in a
// browser tab; visited at its own address, it's a plain "follow" page.
//
// Props (all optional):
//   posts        the latest posts, shown as a preview of what the feed holds: [{ title, url, date, summary, image }] (summary and
//                image optional; image is a picture's address)
//   allPosts     where "See all posts →" goes (shown only with this)
//   narrowPosts  how many posts to show on narrow pages (phones)
//   locale, messages  the language, and any wording to change
// Slot "follow": your own "Other ways to follow" (Bluesky, Mastodon, a
// newsletter…), shown in its own panel beneath the preview.
import settings from "../lib/settings";
import { escapeHtml, messagesFor, pickLocale, translate, translateHtml } from "../lib/i18n";

interface Props {
  posts?: { title: string; url: string; date?: Date | string; summary?: string; image?: string }[];
  allPosts?: string;
  narrowPosts?: number;
  locale?: string;
  messages?: Record<string, string>;
}

const { posts = [], allPosts, narrowPosts } = Astro.props;
const lang = pickLocale(Astro.props.locale, settings.locale, Astro.currentLocale);
const messages = messagesFor(lang, { ...settings.messages, ...Astro.props.messages });
const t = (key: string, vars: Record<string, string> = {}) => translate(messages, lang, key, vars);
const th = (key: string, html: Record<string, string>, vars: Record<string, string> = {}) =>
  translateHtml(messages, lang, key, html, vars);

// Which feed was opened (the address the visitor is at), or, visited at the
// page's own address, the first one.
const key = (path: string) => `/${path.replace(/^\/+|\/+$/g, "")}`;
const opened = settings.feeds.find((feed) => key(feed.path) === key(Astro.originPathname));
const feed = opened ?? settings.feeds[0];
const feedUrl = new URL(feed.path, `${settings.site}/`).href;
const others = settings.feeds.filter((other) => other !== feed);
const list = new Intl.ListFormat(lang, { type: "conjunction" });
const othersHtml = list.format(
  others.map((other) => `<a href="${escapeHtml(other.path)}">${escapeHtml(t(`other.${other.type}`))}</a>`),
);
const versionHtml = others.length
  ? feed.type === "rss"
    ? th("version.preferred", { others: othersHtml })
    : th("version.this", { others: othersHtml }, { type: t(`type.${feed.type}`) })
  : "";
const rawHref = `${feed.path}${feed.path.includes("?") ? "&" : "?"}raw`;

const builtInReaders = [
  { key: "netnewswire", name: "NetNewsWire", url: "https://netnewswire.com/" },
  { key: "newsblur", name: "NewsBlur", url: "https://www.newsblur.com/" },
  { key: "folo", name: "Folo", url: "https://folo.is/" },
  { key: "fluentreader", name: "Fluent Reader", url: "https://hyliu.me/fluent-reader/" },
  { key: "feeder", name: "Feeder", url: "https://play.google.com/store/apps/details?id=com.nononsenseapps.feeder.play" },
  { key: "inoreader", name: "Inoreader", url: "https://www.inoreader.com/" },
].map(({ key, ...reader }) => ({
  ...reader,
  about: t(`readers.${key}`),
  platforms: t(`platforms.${key}`),
}));
const readers = settings.readers === false ? [] : (settings.readers ?? builtInReaders);
const hasFollow = Astro.slots.has("follow");
// The site's address without www, for the preview's heading.
const host = new URL(settings.site).hostname.replace(/^www\./, "");

// Dates use the full locale given ("en-GB": 14 November 2026), not just the
// language the wording is in.
const dateLocale = Astro.props.locale ?? settings.locale ?? Astro.currentLocale ?? lang;
const formatDate = (date: Date | string) =>
  new Intl.DateTimeFormat(dateLocale, { day: "numeric", month: "long", year: "numeric" }).format(new Date(date));
---

<div class="ff">
  <div class="ff__grid">
    <header class="ff__card ff__intro">
      <h1>{opened ? t("heading.feed", { name: settings.name }) : t("heading.page", { name: settings.name })}</h1>
      <p>{t("intro")}</p>
      <div class="ff__address" data-ff-copy>
        {/* The address, with the feed's type beside it (RSS, Atom, JSON Feed). */}
        <div class="ff__field">
          <span class="ff__type">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="6.18" cy="17.82" r="2.18" />
              <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
            </svg>
            {t(`type.${feed.type}`)}
          </span>
          <code>{feedUrl}</code>
        </div>
        <button type="button" data-copy data-copied={t("copied")} hidden>{t("copy")}</button>
      </div>
      {/* feed: hands the address to the reader app registered for it (most Mac
          and iPhone readers). Never standardised and does nothing without an
          app, so it's the secondary choice beside Copy. feed:https://… rather
          than feed://…, which apps read as http. */}
      <p class="ff__open">
        <a href={`feed:${feedUrl}`}>{t("open")}</a>
        <span>{t("openNote")}</span>
      </p>

      {/* Folded away, so the preview below is what catches the eye. */}
      {readers.length > 0 && (
        <details class="ff__readers">
          <summary>{t("readers.heading")}</summary>
          <p>{t("readers.intro")}</p>
          <ul>
            {readers.map((reader) => (
              <li>
                <a href={reader.url}>{reader.name}</a>{reader.about && `, ${reader.about}`}
                {reader.platforms && <span class="ff__platforms">{t("readers.available", { platforms: reader.platforms })}</span>}
              </li>
            ))}
          </ul>
        </details>
      )}

      <p class="ff__small">
        {versionHtml && <Fragment set:html={`${versionHtml} `} />}
        <Fragment set:html={th("raw", { link: `<a href="${escapeHtml(rawHref)}" rel="nofollow">${escapeHtml(t("rawLink"))}</a>` })} />
      </p>
      <p class="ff__small">
        <Fragment set:html={th("newTo", { link: `<a href="https://aboutfeeds.com/">${escapeHtml(t("aboutFeeds"))}</a>` })} />
      </p>
    </header>

    {/* A preview of what the feed holds: its latest entries, newest first.
        Neutral about how much each entry carries (feeds may hold whole
        posts, a summary or just a link): title and date, plus the summary
        and picture when the site gives them. */}
    {posts.length > 0 && (
      <section class="ff__card ff__preview">
        <h2>
          <svg class="ff__rss" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6.18" cy="17.82" r="2.18" />
            <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z" />
          </svg>
          {t("preview.heading", { site: host })}
        </h2>
        {/* A note about the feed, boxed so it doesn't read as part of it. */}
        <p class="ff__preview-intro">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M12 11v6M12 7.5v.01" />
          </svg>
          <span>{t("preview.intro")}</span>
        </p>
        <ul class="ff__entries">
          {posts.map((post, index) => (
            <li class={narrowPosts !== undefined && index >= narrowPosts ? "ff__wide-only" : undefined}>
              <div class="ff__entry">
                <a href={post.url}>{post.title}</a>
                {post.date && <time datetime={new Date(post.date).toISOString()}>{formatDate(post.date)}</time>}
                {post.summary && <p>{post.summary}</p>}
              </div>
              {post.image && <img src={post.image} alt="" loading="lazy" decoding="async" />}
            </li>
          ))}
        </ul>
        {allPosts && <p class="ff__all"><a href={allPosts}>{t("posts.all")}</a></p>}
      </section>
    )}

    {hasFollow && (
      <section class="ff__card ff__follow">
        <h2>{t("follow.heading")}</h2>
        <slot name="follow" />
      </section>
    )}
  </div>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>("[data-ff-copy]")) {
    const button = box.querySelector<HTMLButtonElement>("[data-copy]")!;
    const address = box.querySelector("code")!.textContent ?? "";
    if (!navigator.clipboard) continue;
    const label = button.textContent;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(address);
        button.textContent = button.dataset.copied ?? label;
        setTimeout(() => (button.textContent = label), 2000);
      } catch {
        // Clipboard refused: the address stays on screen to copy by hand.
      }
    });
  }
</script>

<style is:global>
  /* Everything is in :where() (the two buttons: .ff :where()), so the site's
     rules win. Colours and
     sizes come from these variables; set them on .ff (or anywhere above it)
     to match your site. Links use your site's own link styles. */
  :where(.ff) {
    --ff-gap: 24px;
    --ff-radius: 18px;
    --ff-card-padding: clamp(22px, 4vw, 40px);
    --ff-card-bg: color-mix(in srgb, currentColor 4%, transparent);
    --ff-border: color-mix(in srgb, currentColor 14%, transparent);
    --ff-muted: color-mix(in srgb, currentColor 65%, transparent);
    --ff-well: color-mix(in srgb, currentColor 6%, transparent);
    --ff-accent: LinkText;
    --ff-accent-hover: var(--ff-accent);
    --ff-accent-text: Canvas;
    --ff-code-font: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    container: friendly-feed / inline-size;
  }

  :where(.ff__grid) {
    display: grid;
    gap: var(--ff-gap);
  }

  :where(.ff__card) {
    padding: var(--ff-card-padding);
    border: 1px solid var(--ff-border);
    border-radius: var(--ff-radius);
    background: var(--ff-card-bg);
  }

  :where(.ff__card) :where(h1, h2) {
    margin: 0 0 12px;
  }

  :where(.ff__card) :where(h2) {
    font-size: 22px;
  }

  :where(.ff__card) :where(p) {
    margin: 0;
    line-height: 1.7;
  }

  :where(.ff__card) :where(ul) {
    margin: 14px 0 0;
    padding: 0;
    line-height: 1.6;
  }

  :where(.ff__intro) {
    text-align: center;
  }

  :where(.ff__intro) :where(h1) {
    margin-bottom: 14px;
    font-size: clamp(30px, 4vw, 44px);
  }

  :where(.ff__intro) :where(p) {
    max-width: 68ch;
    margin-inline: auto;
  }

  :where(.ff__address) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 20px auto;
  }

  :where(.ff__field) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 12px;
    max-width: 100%;
    padding: 10px 16px;
    border: 1px solid var(--ff-border);
    border-radius: 12px;
    background: var(--ff-well);
  }

  :where(.ff__type) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px 3px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ff-accent) 14%, transparent);
    color: var(--ff-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  :where(.ff__type) :where(svg) {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  :where(.ff__address) :where(code) {
    min-width: 0;
    overflow-wrap: anywhere;
    font-family: var(--ff-code-font);
    font-size: clamp(14px, 3.8vw, 17px);
  }

  /* The buttons have a little specificity (.ff), enough to beat a site's plain
     button and link rules; any class rule of the site's still wins. */
  .ff :where(.ff__address button) {
    padding: 10px 18px;
    border: 0;
    border-radius: 999px;
    background: var(--ff-accent);
    color: var(--ff-accent-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  :where(.ff__open) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    margin: -6px auto 20px !important;
    color: var(--ff-muted);
    font-size: 14px;
  }

  .ff :where(.ff__open a) {
    padding: 8px 16px;
    border: 1px solid var(--ff-accent);
    border-radius: 999px;
    color: var(--ff-accent);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .ff :where(.ff__open a:hover) {
    border-color: var(--ff-accent-hover);
    color: var(--ff-accent-hover);
  }

  :where(.ff__small) {
    color: var(--ff-muted);
    font-size: 14px;
  }

  :where(.ff__small + .ff__small) {
    margin-top: 10px;
  }

  /* "No feed reader yet?": a fold-out under the buttons. */
  :where(.ff__readers) {
    max-width: 52ch;
    margin: 0 auto 22px;
    text-align: left;
  }

  :where(.ff__readers) :where(summary) {
    width: fit-content;
    margin-inline: auto;
    color: var(--ff-accent);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }

  :where(.ff__readers[open]) :where(summary) {
    margin-bottom: 12px;
  }

  :where(.ff__readers) :where(p) {
    margin: 0 !important;
    max-width: none;
  }

  :where(.ff__readers) :where(ul) {
    display: grid;
    gap: 10px;
    padding-left: 1.2em;
  }

  :where(.ff__platforms) {
    display: block;
    color: var(--ff-muted);
    font-size: 14px;
  }

  /* The preview: the feed's latest entries as a plain list. */
  :where(.ff__preview) :where(h2) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  :where(.ff__rss) {
    flex: none;
    width: 0.95em;
    height: 0.95em;
    fill: var(--ff-accent);
  }

  :where(.ff__preview-intro) {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 72ch;
    margin-top: 4px !important;
    padding: 12px 16px;
    border: 1px solid var(--ff-border);
    border-radius: 12px;
    background: var(--ff-well);
    color: var(--ff-muted);
    font-size: 14px;
    line-height: 1.6 !important;
  }

  :where(.ff__preview-intro) :where(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    fill: none;
    stroke: var(--ff-accent);
    stroke-width: 2;
    stroke-linecap: round;
  }

  :where(.ff__entries) {
    margin-top: 20px !important;
    list-style: none;
    border-top: 1px solid var(--ff-border);
  }

  :where(.ff__entries) :where(li) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--ff-border);
  }

  :where(.ff__entry) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  :where(.ff__entry) :where(a) {
    font-weight: 700;
    line-height: 1.35;
  }

  :where(.ff__entry) :where(time) {
    color: var(--ff-muted);
    font-size: 13px;
  }

  :where(.ff__entry) :where(p) {
    display: -webkit-box;
    margin-top: 4px !important;
    overflow: hidden;
    color: var(--ff-muted);
    font-size: 14px;
    line-height: 1.5 !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :where(.ff__entries) :where(img) {
    width: 104px;
    height: 70px;
    object-fit: cover;
    border-radius: 8px;
  }

  :where(.ff__all) {
    margin-top: 16px !important;
    font-weight: 700;
  }

  :where(.ff__follow) :where(ul) {
    display: grid;
    gap: 14px;
    list-style: none;
  }

  :where(.ff__follow) :where(li) {
    display: grid;
    justify-items: start;
    gap: 8px;
  }

  @container friendly-feed (max-width: 600px) {
    :where(.ff__preview .ff__wide-only) {
      display: none;
    }

    :where(.ff__entries) :where(li) {
      grid-template-columns: minmax(0, 1fr);
    }

    :where(.ff__entries) :where(img) {
      display: none;
    }
  }
</style>
